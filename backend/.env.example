# Groq AI API Key (obtain from https://console.groq.com/keys)
GROQ_API_KEY=

# Model selection (optional, default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Groq API Base URL (optional)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Server port (default: 8080)
SERVER_PORT=8080

# SQLite Database path (default: ./data/recall.db)
RECALL_DB_PATH=./data/recall.db

# Maximum upload size in MB (default: 5)
RECALL_MAX_UPLOAD_MB=5

# CORS Allowed Origins (default: * for local dev)
RECALL_CORS_ORIGINS=*
